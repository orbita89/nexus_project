# Скопируйте в infra/.env и поменяйте нужное. Без .env используются эти же значения.
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=nexus_password
POSTGRES_DB=nexus_db
RUST_LOG=info,tower_http=debug

# Корень индексов Tantivy (books, people, works, archive, collections); пусто - выкл.
SEARCH_INDEX_DIR=/var/lib/nexus/tantivy
