# Настройки staging или прода для infra/docker-compose.prod.yml.
# На сервере: cp infra/.env.prod.example infra/.env.prod и заполнить. infra/.env.prod не коммитится.
# Секреты — свои для каждого окружения, генерировать: openssl rand -base64 48

# staging или production: имя проекта compose (тома и контейнеры не пересекаются).
NEXUS_ENV=staging
# Образ из CI: ghcr.io/orbita89/nexus_project:<sha коммита>
NEXUS_IMAGE=ghcr.io/orbita89/nexus_project:CHANGE_ME
HTTP_PORT=80

POSTGRES_USER=nexus
POSTGRES_DB=nexus
POSTGRES_PASSWORD=CHANGE_ME

MEILI_MASTER_KEY=CHANGE_ME
# Не короче 32 символов.
JWT_SECRET=CHANGE_ME

# Почта: настоящий SMTP (Яндекс 360, Mailgun, ...).
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Nexus <no-reply@example.com>

# Адрес фронтенда (ссылки в письмах) и API (redirect_uri для OAuth).
APP_BASE_URL=https://staging.example.com
PUBLIC_URL=https://staging.example.com

# Swagger UI на /docs: true на staging, false на проде.
API_DOCS=true
RUST_LOG=info

# OAuth: у каждого окружения свои приложения у провайдеров (свой redirect_uri).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
