# Авторизация: все сценарии против живого окружения.
# Нужно: make up, make seed (тестовые пользователи, пароль password123).
# Письма берутся из Mailpit (http://localhost:8025) через его API.
# Запросы зависят друг от друга (значения сохраняются в client.global) — запускайте файл целиком.
# Из консоли: make http

### Вход админом
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "admin", "password": "password123" }

> {%
    client.test("200 и роль admin", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.user.role === "admin", JSON.stringify(response.body.user));
    });
    client.global.set("admin_token", response.body.access_token);
%}

### Вход обычным пользователем (по email, регистр не важен)
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "USER@nexus.local", "password": "password123" }

> {%
    client.test("200 и роль user", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.user.role === "user");
    });
    client.global.set("user_token", response.body.access_token);
    client.global.set("user_refresh", response.body.refresh_token);
%}

### Неверный пароль → 401
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "user", "password": "wrong-password" }

> {%
    client.test("401", () => client.assert(response.status === 401, `got ${response.status}`));
%}

### Заблокированный пользователь → 401
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "blocked", "password": "password123" }

> {%
    client.test("401", () => client.assert(response.status === 401, `got ${response.status}`));
%}

### Профиль по access-токену
GET {{host}}/api/v1/auth/me
Authorization: Bearer {{user_token}}

> {%
    client.test("200 и свой профиль", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.username === "user");
    });
%}

### Профиль без токена → 401
GET {{host}}/api/v1/auth/me

> {%
    client.test("401", () => client.assert(response.status === 401, `got ${response.status}`));
%}

### Обновление токенов (refresh одноразовый: выдаётся новый)
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{ "refresh_token": "{{user_refresh}}" }

> {%
    // Что токен новый, а старый отозван, проверяют Rust-тесты (app/tests/auth.rs).
    client.test("200 и выдан refresh-токен", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(!!response.body.refresh_token, JSON.stringify(response.body));
    });
    client.global.set("user_token", response.body.access_token);
    client.global.set("user_refresh", response.body.refresh_token);
%}

### Мои активные сессии: текущая помечена
GET {{host}}/api/v1/auth/sessions
Authorization: Bearer {{user_token}}

> {%
    client.test("200 и есть текущая сессия", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.some(s => s.current === true), JSON.stringify(response.body));
    });
%}

### Админка: обычный пользователь → 403
GET {{host}}/api/v1/auth/admin/users
Authorization: Bearer {{user_token}}

> {%
    client.test("403", () => client.assert(response.status === 403, `got ${response.status}`));
%}

### Админка: список пользователей
GET {{host}}/api/v1/auth/admin/users?limit=10
Authorization: Bearer {{admin_token}}

> {%
    client.test("200 и есть тестовые пользователи", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.some(u => u.username === "author"));
    });
%}

### Регистрация по паролю (уникальный адрес на каждый запуск)
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "u{{$timestamp}}@example.com",
  "username": "u{{$timestamp}}",
  "password": "password123",
  "display_name": "Новичок"
}

> {%
    client.test("201, email не подтверждён, токенов нет", () => {
        client.assert(response.status === 201, `got ${response.status}`);
        client.assert(response.body.email_verified_at === null);
        client.assert(response.body.access_token === undefined);
    });
    client.global.set("new_email", response.body.email);
    client.global.set("new_username", response.body.username);
    client.global.set("new_user_id", response.body.id);
%}

### До подтверждения email вход по паролю запрещён → 403
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "{{new_username}}", "password": "password123" }

> {%
    client.test("403 email not verified", () => {
        client.assert(response.status === 403, `got ${response.status}`);
        client.assert(response.body.error === "email not verified");
    });
%}

### Письмо с подтверждением пришло в Mailpit
GET {{mailpit}}/api/v1/message/latest

> {%
    client.test("письмо на новый адрес со ссылкой", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.To[0].Address === client.global.get("new_email"), JSON.stringify(response.body.To));
        client.assert(/verify-email\?token=/.test(response.body.Text), response.body.Text);
    });
    client.global.set("verify_token", response.body.Text.match(/token=([0-9a-f]{64})/)[1]);
%}

### Подтверждение email по ссылке → сразу вход
POST {{host}}/api/v1/auth/email/verify
Content-Type: application/json

{ "token": "{{verify_token}}" }

> {%
    client.test("200, email подтверждён, есть токены", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.user.email_verified_at !== null);
        client.assert(!!response.body.access_token);
    });
    client.global.set("new_token", response.body.access_token);
%}

### Забыл пароль → письмо со ссылкой
POST {{host}}/api/v1/auth/password/forgot
Content-Type: application/json

{ "email": "{{new_email}}" }

> {%
    client.test("202", () => client.assert(response.status === 202, `got ${response.status}`));
%}

### Письмо о сбросе пароля пришло в Mailpit
GET {{mailpit}}/api/v1/message/latest

> {%
    client.test("письмо со ссылкой сброса", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(/reset-password\?token=/.test(response.body.Text), response.body.Text);
    });
    client.global.set("reset_token", response.body.Text.match(/token=([0-9a-f]{64})/)[1]);
%}

### Новый пароль по ссылке
POST {{host}}/api/v1/auth/password/reset
Content-Type: application/json

{ "token": "{{reset_token}}", "password": "new-password-456" }

> {%
    client.test("204", () => client.assert(response.status === 204, `got ${response.status}`));
%}

### Вход с новым паролем
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "{{new_username}}", "password": "new-password-456" }

> {%
    client.test("200", () => client.assert(response.status === 200, `got ${response.status}`));
%}

# ------------------------------------------------------------------ свой профиль (новый пользователь)

### Профиль: имя и аватар
PATCH {{host}}/api/v1/auth/me
Authorization: Bearer {{new_token}}
Content-Type: application/json

{ "display_name": "Нео", "avatar_url": "https://example.com/neo.png" }

> {%
    client.test("200", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.display_name === "Нео" && response.body.avatar_url === "https://example.com/neo.png");
        client.assert(response.body.username_changed_at === null);
    });
%}

### Аватар только по https → 400
PATCH {{host}}/api/v1/auth/me
Authorization: Bearer {{new_token}}
Content-Type: application/json

{ "avatar_url": "http://example.com/neo.png" }

> {%
    client.test("400 с {error}", () => {
        client.assert(response.status === 400, `got ${response.status}`);
        client.assert(typeof response.body.error === "string");
    });
%}

### Сменить username
PATCH {{host}}/api/v1/auth/me
Authorization: Bearer {{new_token}}
Content-Type: application/json

{ "username": "{{new_username}}_x" }

> {%
    client.test("200, username сменён", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.username.endsWith("_x") && response.body.username_changed_at !== null);
    });
    client.global.set("new_username", response.body.username);
%}

### Снова раньше чем через 30 дней → 400
PATCH {{host}}/api/v1/auth/me
Authorization: Bearer {{new_token}}
Content-Type: application/json

{ "username": "{{new_username}}y" }

> {%
    client.test("400", () => {
        client.assert(response.status === 400, `got ${response.status}`);
        client.assert(response.body.error.includes("30 days"), response.body.error);
    });
%}

### Сменить email без пароля → 400 (пароль у аккаунта задан)
POST {{host}}/api/v1/auth/me/email
Authorization: Bearer {{new_token}}
Content-Type: application/json

{ "new_email": "moved-{{new_email}}" }

> {%
    client.test("400", () => client.assert(response.status === 400, `got ${response.status}`));
%}

### Сменить email: письмо на новый адрес
POST {{host}}/api/v1/auth/me/email
Authorization: Bearer {{new_token}}
Content-Type: application/json

{ "new_email": "moved-{{new_email}}", "password": "new-password-456" }

> {%
    client.test("202", () => client.assert(response.status === 202, `got ${response.status}`));
%}

### Ссылка подтверждения пришла на новый адрес
GET {{mailpit}}/api/v1/message/latest

> {%
    client.test("письмо на новый адрес", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.To[0].Address === "moved-" + client.global.get("new_email"), JSON.stringify(response.body.To));
        client.assert(/change-email\?token=/.test(response.body.Text), response.body.Text);
    });
    client.global.set("change_email_token", response.body.Text.match(/token=([0-9a-f]{64})/)[1]);
%}

### Подтвердить новый email (ссылку можно открыть и без входа)
POST {{host}}/api/v1/auth/email/change/confirm
Content-Type: application/json

{ "token": "{{change_email_token}}" }

> {%
    client.test("200", () => client.assert(response.status === 200, `got ${response.status}`));
    client.test("email заменён", () => client.assert(response.body.email.startsWith("moved-"), response.body.email));
    client.test("email подтверждён", () => client.assert(response.body.email_verified_at !== null));
    client.global.set("old_email", client.global.get("new_email"));
    client.global.set("new_email", response.body.email);
%}

### На старый адрес пришло уведомление
GET {{mailpit}}/api/v1/message/latest

> {%
    client.test("уведомление на старый адрес", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.To[0].Address === client.global.get("old_email"), JSON.stringify(response.body.To));
        client.assert(response.body.Text.includes(client.global.get("new_email")), response.body.Text);
    });
%}

### Вход по новому email и новому username
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "{{new_email}}", "password": "new-password-456" }

> {%
    client.test("200", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.user.username === client.global.get("new_username"));
    });
    client.global.set("new_token", response.body.access_token);
%}

### Привязанные провайдеры: пока пусто
GET {{host}}/api/v1/auth/me/oauth
Authorization: Bearer {{new_token}}

> {%
    client.test("200, пустой список", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(Array.isArray(response.body) && response.body.length === 0);
    });
%}

### Привязать выключенного провайдера → 404 (в dev ключей нет)
POST {{host}}/api/v1/auth/me/oauth/google
Authorization: Bearer {{new_token}}

> {%
    client.test("404", () => client.assert(response.status === 404, `got ${response.status}`));
%}

### Вход по почте без пароля: запросить ссылку (новый адрес — аккаунт создастся)
POST {{host}}/api/v1/auth/email/login
Content-Type: application/json

{ "email": "magic{{$timestamp}}@example.com" }

> {%
    client.test("202", () => client.assert(response.status === 202, `got ${response.status}`));
%}

### Ссылка для входа пришла в Mailpit
GET {{mailpit}}/api/v1/message/latest

> {%
    client.test("письмо со ссылкой входа", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(/email-login\?token=/.test(response.body.Text), response.body.Text);
    });
    client.global.set("magic_token", response.body.Text.match(/token=([0-9a-f]{64})/)[1]);
%}

### Переход по ссылке → вход (аккаунт создан, email подтверждён)
POST {{host}}/api/v1/auth/email/login/confirm
Content-Type: application/json

{ "token": "{{magic_token}}" }

> {%
    client.test("200 и новый пользователь", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.user.email_verified_at !== null);
        client.assert(response.body.user.username.startsWith("magic"), response.body.user.username);
    });
%}

### Dev login: войти как author без пароля (только при DEV_LOGIN=true)
POST {{host}}/api/v1/auth/dev/login
Content-Type: application/json

{ "login": "author" }

> {%
    client.test("200 и роль author", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.user.role === "author");
    });
%}

### Админ повышает нового пользователя до author
PATCH {{host}}/api/v1/auth/admin/users/{{new_user_id}}/role
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{ "role": "author" }

> {%
    client.test("200 и роль author", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.role === "author");
    });
%}

### Админ блокирует нового пользователя
PATCH {{host}}/api/v1/auth/admin/users/{{new_user_id}}/status
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{ "is_active": false }

> {%
    client.test("200 и is_active=false", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.is_active === false);
    });
%}

### Заблокированный не может войти → 401
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "{{new_username}}", "password": "new-password-456" }

> {%
    client.test("401", () => client.assert(response.status === 401, `got ${response.status}`));
%}

### Включённые OAuth-провайдеры (пустой список, пока не заданы ключи)
GET {{host}}/api/v1/auth/oauth/providers

> {%
    client.test("200 и список", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(Array.isArray(response.body.providers));
    });
%}

### Выход: refresh-токен отзывается
POST {{host}}/api/v1/auth/logout
Content-Type: application/json

{ "refresh_token": "{{user_refresh}}" }

> {%
    client.test("204", () => client.assert(response.status === 204, `got ${response.status}`));
%}

### После выхода refresh не работает → 401
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{ "refresh_token": "{{user_refresh}}" }

> {%
    client.test("401", () => client.assert(response.status === 401, `got ${response.status}`));
%}
