%}

### Добавить участника: Фрэнк Херберт, автор
GET {{host}}/api/v1/catalog/people/frank-herbert

> {%
    client.global.set("person_id", response.body.id);
%}

###
POST {{host}}/api/v1/catalog/admin/entities/{{entity_id}}/credits
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{ "person_id": "{{person_id}}", "role": "author" }

> {%
    client.test("201", () => {
        client.assert(response.status === 201, `got ${response.status}`);
        client.assert(response.body.person.slug === "frank-herbert");
    });
    client.global.set("credit_id", response.body.id);
%}

### Новая сущность находится поиском (индекс обновляется с задержкой в доли секунды)
# Meilisearch индексирует асинхронно: без паузы запрос иногда обгоняет индексацию.
< {%
    const start = Date.now();
    while (Date.now() - start < 1000) {}
%}
GET {{host}}/api/v1/catalog/search?q=Zzhttpcheck

> {%
    client.test("найдена", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.items.some(e => e.id === client.global.get("entity_id")), JSON.stringify(response.body));
    });
%}

### Связанные: новая книга — сиквел «Дюны» (роман)
GET {{host}}/api/v1/catalog/entities/dune-novel

> {%
    client.global.set("dune_novel_id", response.body.id);
%}

###
PUT {{host}}/api/v1/catalog/admin/entities/{{entity_id}}/relations
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{ "kind": "prequel", "to_id": "{{dune_novel_id}}" }

> {%
    client.test("200, приквел — роман", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.prequels.some(e => e.slug === "dune-novel"), JSON.stringify(response.body));
    });
%}

### Роман видит сиквел в карточке
GET {{host}}/api/v1/catalog/entities/dune-novel

> {%
    client.test("200, новая книга в sequels", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.related.sequels.some(e => e.id === client.global.get("entity_id")), JSON.stringify(response.body.related));
    });
%}

### Связь с собой → 409
PUT {{host}}/api/v1/catalog/admin/entities/{{entity_id}}/relations
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{ "kind": "sequel", "to_id": "{{entity_id}}" }

> {%
    client.test("409 self_relation", () => {
        client.assert(response.status === 409, `got ${response.status}`);
        client.assert(response.body.code === "self_relation");
    });
%}

