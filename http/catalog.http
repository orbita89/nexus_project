### Человек: создать, изменить, удалить
POST {{host}}/api/v1/catalog/admin/people
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{ "slug": "http-check-{{$timestamp}}", "full_name": "Проверочный Человек", "birth_date": "1990-01-01" }

> {%
    client.test("201", () => client.assert(response.status === 201, `got ${response.status}`));
    client.global.set("new_person_id", response.body.id);
%}

###
PATCH {{host}}/api/v1/catalog/admin/people/{{new_person_id}}
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{ "birth_date": null, "bio": "Создан из catalog.http" }

> {%
    client.test("200", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.birth_date === null);
    });
%}

###
DELETE {{host}}/api/v1/catalog/admin/people/{{new_person_id}}
