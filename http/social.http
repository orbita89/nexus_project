# ------------------------------------------------------------------ коллекции

### Новые публичные коллекции
GET {{host}}/api/v1/social/collections

> {%
    client.test("200, только публичные", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.total >= 2, JSON.stringify(response.body));
        client.assert(response.body.items.every(c => c.is_public && c.owner.username));
    });
%}

### Коллекции user глазами гостя: без приватной
GET {{host}}/api/v1/social/users/user/collections

> {%
    client.test("200, нет приватных", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.items.every(c => c.is_public));
        client.global.set("guest_total", response.body.total);
    });
%}

### Коллекции user глазами владельца: с приватной
GET {{host}}/api/v1/social/users/user/collections
Authorization: Bearer {{user_token}}

> {%
    client.test("200, есть приватная", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.items.some(c => !c.is_public));
        client.assert(response.body.total > client.global.get("guest_total"));
    });
%}

### В каких коллекциях есть «Дюна» 2021
GET {{host}}/api/v1/social/entities/dune-2021/collections

> {%
    client.test("200, «Дюна во всех видах»", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.items.some(c => c.title === "Дюна во всех видах"));
    });
%}

### Создать приватную коллекцию
POST {{host}}/api/v1/social/collections
Authorization: Bearer {{user_token}}
Content-Type: application/json

{ "title": "Проверка из http/social.http", "is_public": false }

> {%
    client.test("201", () => {
        client.assert(response.status === 201, `got ${response.status}`);
        client.assert(response.body.is_public === false && response.body.items.length === 0);
    });
    client.global.set("collection_id", response.body.id);
%}

### Приватная коллекция гостю — 404
GET {{host}}/api/v1/social/collections/{{collection_id}}

> {%
    client.test("404", () => client.assert(response.status === 404, `got ${response.status}`));
%}

### Добавить книгу с заметкой
PUT {{host}}/api/v1/social/collections/{{collection_id}}/items/neuromancer
Authorization: Bearer {{user_token}}
Content-Type: application/json

{ "note": "Начало киберпанка" }

> {%
    client.test("201, позиция 0", () => {
        client.assert(response.status === 201, `got ${response.status}`);
        client.assert(response.body.position === 0 && response.body.note === "Начало киберпанка");
    });
%}

### Добавить игру без тела — в конец
PUT {{host}}/api/v1/social/collections/{{collection_id}}/items/cyberpunk-2077
Authorization: Bearer {{user_token}}

> {%
    client.test("201, позиция 1", () => {
        client.assert(response.status === 201, `got ${response.status}`);
        client.assert(response.body.position === 1);
    });
%}

### Переставить: игра первой
PUT {{host}}/api/v1/social/collections/{{collection_id}}/items
Authorization: Bearer {{user_token}}
Content-Type: application/json

{ "entities": ["cyberpunk-2077", "neuromancer"] }

> {%
    client.test("200, новый порядок", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.items.map(i => i.entity.slug).join() === "cyberpunk-2077,neuromancer");
    });
%}

### Сделать публичной и переименовать
PATCH {{host}}/api/v1/social/collections/{{collection_id}}
Authorization: Bearer {{user_token}}
Content-Type: application/json

{ "title": "Киберпанк: с чего начать", "is_public": true }

> {%
    client.test("200", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.is_public && response.body.items_count === 2);
    });
%}

