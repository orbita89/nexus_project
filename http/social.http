# Социальное: рецензии и оценки, подписки, коллекции, модерация против живого окружения.
# Нужно: make up, make seed (пользователи, каталог и social из seeds/*.sql).
# Запросы зависят друг от друга (значения сохраняются в client.global) — запускайте файл целиком.
# Всё, что файл создаёт, он же и удаляет: повторный запуск видит те же данные дампа. Остатки
# прерванного прогона (например, после 429 на входе) не мешают: следующий прогон их уберёт.
# Из консоли: make http

### Вход обычным пользователем
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "user", "password": "password123" }

> {%
    client.test("200", () => client.assert(response.status === 200, `got ${response.status}`));
    client.global.set("user_token", response.body.access_token);
%}

### Вход автором
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "author", "password": "password123" }

> {%
    client.test("200", () => client.assert(response.status === 200, `got ${response.status}`));
    client.global.set("author_token", response.body.access_token);
%}

### Вход админом
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "login": "admin", "password": "password123" }

> {%
    client.test("200", () => client.assert(response.status === 200, `got ${response.status}`));
    client.global.set("admin_token", response.body.access_token);
%}

# ------------------------------------------------------------------ профиль

### Профиль автора гостем: счётчики, отношения нет
GET {{host}}/api/v1/social/users/author

> {%
    client.test("200, relation = null", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.user.username === "author");
        client.assert(response.body.followers_count >= 2 && response.body.reviews_count >= 4, JSON.stringify(response.body));
        client.assert(response.body.relation === null);
    });
%}

### Профиль автора глазами user: подписаны друг на друга (seeds/social.sql)
GET {{host}}/api/v1/social/users/author
Authorization: Bearer {{user_token}}

> {%
    client.test("200, following и followed_by", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.relation.following === true && response.body.relation.followed_by === true);
    });
%}

### Ошибка разбора пути — тоже {error}
GET {{host}}/api/v1/social/collections/not-a-uuid

> {%
    client.test("400 с {error}", () => {
        client.assert(response.status === 400, `got ${response.status}`);
        client.assert(typeof response.body.error === "string");
    });
%}

# ------------------------------------------------------------------ рецензии

### Рецензии на «Дюну» 2021 без токена: только с текстом, новые сверху
GET {{host}}/api/v1/social/entities/dune-2021/reviews

> {%
    client.test("200, у всех есть текст, автор и сущность", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.total >= 2, JSON.stringify(response.body));
        client.assert(response.body.items.every(r => r.body && r.author.username && r.entity.slug === "dune-2021"));
    });
%}

### Все рецензии, включая оценки без текста, высокие оценки сверху
GET {{host}}/api/v1/social/entities/dune-2021/reviews?all=true&sort=rating_desc

> {%
    client.test("200, оценки по убыванию", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        const ratings = response.body.items.map(r => r.rating).filter(r => r !== null);
        client.assert(ratings.every((r, i) => i === 0 || ratings[i - 1] >= r), JSON.stringify(ratings));
        client.assert(response.body.items.some(r => r.body === null), "есть оценка без текста");
    });
%}

### Сводка оценок
GET {{host}}/api/v1/social/entities/dune-2021/rating

> {%
    client.test("200, среднее до 0.1 и 10 корзин", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.count >= 3, JSON.stringify(response.body));
        client.assert(response.body.distribution.length === 10);
        client.assert(Math.round(response.body.average * 10) === response.body.average * 10);
    });
%}

### Неизвестная сущность — 404
GET {{host}}/api/v1/social/entities/no-such-entity/rating

> {%
    client.test("404", () => client.assert(response.status === 404, `got ${response.status}`));
%}

### Своя рецензия без токена — 401
PUT {{host}}/api/v1/social/entities/elden-ring/review
Content-Type: application/json

{ "rating": 9 }

> {%
    client.test("401", () => client.assert(response.status === 401, `got ${response.status}`));
%}

### Оценка вне 1–10 — 400
PUT {{host}}/api/v1/social/entities/elden-ring/review
Authorization: Bearer {{user_token}}
Content-Type: application/json

{ "rating": 11 }

> {%
    client.test("400 с {error}", () => {
        client.assert(response.status === 400, `got ${response.status}`);
        client.assert(typeof response.body.error === "string");
    });
%}

### Написать рецензию на Elden Ring
PUT {{host}}/api/v1/social/entities/elden-ring/review
Authorization: Bearer {{user_token}}
Content-Type: application/json

{ "rating": 9, "body": "Проверка из http/social.http" }

> {%
    // 200 — рецензия осталась от прерванного прогона: PUT её заменяет.
    client.test("201 или 200", () => {
        client.assert(response.status === 201 || response.status === 200, `got ${response.status}`);
        client.assert(response.body.author.username === "user");
        client.assert(response.body.entity.slug === "elden-ring");
    });
    client.global.set("review_id", response.body.id);
%}

### Заменить: только оценка
PUT {{host}}/api/v1/social/entities/elden-ring/review
Authorization: Bearer {{user_token}}
Content-Type: application/json

{ "rating": 10 }

> {%
    client.test("200, текст убран, id тот же", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.id === client.global.get("review_id"));
        client.assert(response.body.rating === 10 && response.body.body === null);
    });
%}

### Своя рецензия
GET {{host}}/api/v1/social/entities/elden-ring/review
Authorization: Bearer {{user_token}}

> {%
    client.test("200", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.rating === 10);
    });
%}

### Удалить свою рецензию
DELETE {{host}}/api/v1/social/entities/elden-ring/review
Authorization: Bearer {{user_token}}

> {%
    client.test("204", () => client.assert(response.status === 204, `got ${response.status}`));
%}

### Рецензии пользователя
GET {{host}}/api/v1/social/users/user/reviews?limit=3

> {%
    client.test("200, 3 из дампа, Elden Ring уже нет", () => {
        client.assert(response.status === 200, `got ${response.status}`);
        client.assert(response.body.items.length === 3 && response.body.total >= 5, JSON.stringify(response.body));
        client.assert(response.body.items.every(r => r.author.username === "user" && r.entity.slug !== "elden-ring"));
    });
%}

